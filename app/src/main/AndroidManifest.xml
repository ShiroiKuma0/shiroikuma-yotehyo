        <!-- The 保存復元 state-export contract (白い熊 自由作業盤 backs up every sister app in one run).
             Deliberately exported with NO android:permission — the calling task cannot hold one, so the
             automation token is the gate, and every action is refused until the switch is on.
             CANCEL_EXPORT rides this same receiver because a service would be exported="false" and so
             unreachable from the caller. See receivers/StateExportReceiver. -->
        <receiver
            android:name=".receivers.StateExportReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="shiroikuma.yotehyo.action.EXPORT_STATE" />
                <action android:name="shiroikuma.yotehyo.action.LIST_CATEGORIES" />
                <action android:name="shiroikuma.yotehyo.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <!-- The data door (contract v2 §2a): 白い熊 応用管理 backs this app up WITH its data and puts
             it back on a wiped phone. Exported with no android:permission for a real reason — a custom
             permission would have to be "normal" (any app may hold it) or "signature" (impossible:
             every app in this family has its own keystore, 42 of them), and neither buys anything the
             caller check does not. AutomationCallers verifies the exact package name, cross-checks the
             uid the kernel reports, and pins the caller's signing certificate. -->
        <provider
            android:name=".automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true" />

        <!-- Where an export or import actually runs: a binder call returns in milliseconds, this can
             take minutes, and a backgrounded app writing for minutes is frozen mid-stream on this
             EMUI — which would put a truncated archive underneath a success reply. -->
        <service
            android:name=".automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!-- Capability discovery, read straight off the manifest rather than asked over an intent:
             白い熊 freezes apps aggressively, and a frozen app cannot be asked anything. 応用管理 reads
             these across every installed package at once with MATCH_UNINSTALLED_PACKAGES |
             MATCH_DISABLED_COMPONENTS. An app without them is simply not offered for data backup. -->
        <meta-data
            android:name="shiroikuma.automation.contract"
            android:value="2" />
        <meta-data
            android:name="shiroikuma.automation.format"
            android:value="1" />
        <meta-data
            android:name="shiroikuma.automation.min_format"
            android:value="1" />

