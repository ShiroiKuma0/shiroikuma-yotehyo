        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- The automation data door (contract v2 §2a) runs its export/import in a foreground service, so
         this can no longer stop at API 32 the way upstream left it — on 33+ startForeground() without
         the permission is a SecurityException, and 34+ additionally wants the subtype permission that
         matches android:foregroundServiceType="specialUse". See automation/AutomationDataService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

