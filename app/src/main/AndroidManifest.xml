        android:maxSdkVersion="28" />

    <!-- So a 保存復元 automation broadcast can write its backup to the arbitrary absolute directory it
         names (白い熊's own archive folder, outside Download/ and Documents/). Nothing in the app's own
         UI needs it; the Export/Import page writes through SAF. Granted by hand from the row under
         UI page → Export / Import → Automation. See receivers/StateExportReceiver. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

