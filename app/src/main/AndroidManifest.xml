    <queries>
        <package android:name="org.fossify.calendar.debug" />
        <package android:name="org.fossify.calendar" />
    </queries>

    <!-- The automation callers. WITHOUT THESE the reply broadcast's setPackage() fails silently on
         Android 11+: the export runs, writes correctly, and is never heard of. Both are named on
         purpose — §1's 保存復元 batch is driven by 自由作業盤, and §2a's data backup/restore by
         応用管理, so an app that lists only one is inaudible to the other. Until 2026-09-04 this fork
         listed NEITHER, which means every §1 reply it has ever sent was discarded by the framework.
         It is not only the reply that breaks: getPackageInfo and getPackagesForUid are visibility
         filtered too, so an invisible caller fails AutomationCallers' IDENTITY check and is refused as
         "signature unreadable" rather than merely going unheard.
         A third caller is a one line addition here; QUERY_ALL_PACKAGES is a Play-policy-restricted
         permission and buys nothing this needs. -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

