<?xml version="1.0" encoding="utf-8"?>
<!-- kxkb-style section header: a full-width hairline spacer above the group (hidden on the first
     section), then a big bold accent heading with a text-wide underline. The inner wrap_content
     layout shrink-wraps to the title, so the match_parent underline resolves to the text width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:id="@+id/theme_section_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/medium_margin">

        <TextView
            android:id="@+id/theme_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/theme_section_underline"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no" />

    </LinearLayout>

</LinearLayout>
